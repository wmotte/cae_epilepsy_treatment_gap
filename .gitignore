# R session files
.Rhistory
.RData
.Rproj.user/
*.Rproj

# renv library (renv.lock is committed)
renv/library/
renv/staging/
renv/local/

# Simulation traces are regenerated by R/run_all.R (about 7 MB)
data/derived/sim_traces.rds

# The full UN WPP 2024 workbook is 131 MB, over GitHub's file limit.
# The committed extract in data/raw/ is used instead.
data/raw/WPP2024_MORT_F07_1_ABRIDGED_LIFE_TABLE_BOTH_SEXES.xlsx

# Temporary files
*.tmp
*.embed.tmp
~$*
.DS_Store

# ---- GitHub R template ----
# History files
.Rapp.history

# Session Data files
.RDataTmp

# User-specific files
.Ruserdata

# Example code in package build process
*-Ex.R

# Output files from R CMD build
/*.tar.gz

# Output files from R CMD check
/*.Rcheck/

# RStudio files

# produced vignettes
vignettes/*.html
vignettes/*.pdf

# OAuth2 token, see https://github.com/hadley/httr/releases/tag/v0.3
.httr-oauth

